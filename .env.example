# Copy to .env and fill in. Never commit .env.
# On Streamlit Cloud these go in st.secrets; in GitHub Actions, in repo secrets.

# local = development, prod = deployed (yfinance_dev refuses to run in prod)
APP_ENV=local

# Database: SQLite locally, Neon Postgres when deployed
DATABASE_URL=sqlite:///stock_tracker.db

# Anthropic (put it here only, never in a shell profile)
ANTHROPIC_API_KEY=
MONTHLY_BUDGET_USD=8.00

# Brave News Search API (live queries only; results are not stored)
BRAVE_SEARCH_API_KEY=
MONTHLY_SEARCH_CAP=900

# Price provider, used only for daily percent changes. See docs/data-licensing.md
PRICE_PROVIDER=yfinance_dev
ALPHAVANTAGE_API_KEY=

# SEC EDGAR User-Agent: a name and a contact email
EDGAR_USER_AGENT_NAME=
EDGAR_USER_AGENT_EMAIL=

# Attribution ladder thresholds (defaults from AGENTS.md rule 14)
MARKET_ALERT_PCT=2.0
MARKET_MAJOR_PCT=3.0
MOVE_THRESHOLD_PCT=5.0
DEMO_MOVE_THRESHOLD_PCT=3.0
RESIDUAL_PCT=3.0
INDUSTRY_MIN_PEERS=3
INDUSTRY_MOVE_PCT=3.0
MARKET_NOTE_MIN_INTERVAL_HOURS=3
# Optional overrides (defaults in tracker/config.py)
# MODEL_ROUTINE=claude-haiku-5-5
# MODEL_PROFILE=claude-sonnet-5-5
# MONTHLY_BUDGET_USD=8.00

# Web app: Google OAuth client (redirect URI <BASE_URL>/auth/callback) and the session cookie key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
BASE_URL=http://localhost:8000

# Private access: open (anyone with the URL) or link (shared links only). Default: link in prod.
ACCESS_MODE=
# Owner email: may create and revoke shared links
OWNER_EMAIL=
# Email alerts: none for now
EMAIL_PROVIDER=none   # gmail to turn email alerts on
# Email alerts through the site's own Gmail account (app password, never the account password)
# EMAIL_PROVIDER=gmail
SMTP_USER=
SMTP_APP_PASSWORD=

# Deploy: Neon connection string (deploy/cloudrun.sh copies it into Google Secret Manager)
NEON_DATABASE_URL=

# Optional Tiingo Starter token for the in-memory watchlist aggregate.
TIINGO_API_KEY=
